@page
@model Touching_Grass.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Create account"; }
<h1>Create account</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span>
    <label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span>
    <label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    <label asp-for="DefaultZipCode"></label><input asp-for="DefaultZipCode" class="form-control" inputmode="numeric" autocomplete="postal-code" /><span asp-validation-for="DefaultZipCode" class="text-danger"></span>
    <button type="submit" class="btn btn-primary mt-3">Create account</button>
</form>