@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Plantwise - Watering Guide";
}

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-10">
        <div class="plantwise-page-brand mb-3">
            <img src="~/images/plant_wise_logo.png" alt="PlantWise logo" class="plantwise-page-brand__logo" />
            <h1 class="display-5 mb-0">PlantWise</h1>
        </div>
        <p class="lead">Dynamic watering advice for your plants that knows the weather.</p>

        <form method="post" class="card shadow-sm" id="watering-form">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="ZipCode" class="form-label"></label>
                    <input asp-for="ZipCode" class="form-control" inputmode="numeric" autocomplete="postal-code" aria-describedby="zip-help" />
                    <div id="zip-help" class="form-text">Enter a supported five-digit USA ZIP code.</div>
                    <span asp-validation-for="ZipCode" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PlantName" class="form-label"></label>
                    <input asp-for="PlantName" class="form-control" autocomplete="off" data-plant-input aria-describedby="plant-help plant-search-status" aria-expanded="false" aria-autocomplete="list" />
                    <input asp-for="SelectedPlantId" type="hidden" data-plant-id />
                    <div class="form-text" id="plant-help">Type at least three characters to see common and scientific name suggestions.</div>
                    <ul class="list-group mt-2 d-none" id="plant-suggestions" role="listbox" aria-label="Plant suggestions"></ul>
                    <p class="small text-muted mt-2 mb-0 d-none" id="plant-search-status" role="status"></p>
                    <span asp-validation-for="PlantName" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary" data-submit-button>
                    <span data-submit-label>Calculate watering need</span>
                    <span class="spinner-border spinner-border-sm d-none" aria-hidden="true" data-submit-spinner></span>
                </button>
            </div>
        </form>

        @if (Model.RecommendationError is not null)
        {
            <div class="alert alert-warning mt-4" role="alert">@Model.RecommendationError</div>
        }

        @if (Model.Recommendation is not null)
        {
            <div class="card shadow-sm mt-4" aria-labelledby="recommendation-heading">
                <div class="card-body">
                    <h2 id="recommendation-heading" class="h4">@Model.Recommendation.PlantDisplayName</h2>
                    <p class="text-muted mb-3">ZIP code: @Model.Recommendation.ZipCode</p>
                    <p class="display-6">@Model.Recommendation.NetNeedInches.ToString("0.00") in</p>
                    @if (Model.WaterStatusMessage is not null)
                    {
                        <p class="lead" role="status">@Model.WaterStatusMessage.Message</p>
                    }
                    <p class="mb-0">@Model.Recommendation.Explanation</p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h3 class="h5">How this was calculated</h3>
                    <dl class="row mb-0">
                        <dt class="col-sm-7">Evapotranspiration</dt>
                        <dd class="col-sm-5">@Model.Recommendation.EvapotranspirationInches.ToString("0.00") in</dd>
                        <dt class="col-sm-7">Plant water factor</dt>
                        <dd class="col-sm-5">@Model.Recommendation.PlantFactor.ToString("0.00")</dd>
                        <dt class="col-sm-7">Gross water need</dt>
                        <dd class="col-sm-5">@Model.Recommendation.GrossNeedInches.ToString("0.00") in</dd>
                        <dt class="col-sm-7">Rainfall</dt>
                        <dd class="col-sm-5">− @Model.Recommendation.RainfallInches.ToString("0.00") in</dd>
                        <dt class="col-sm-7">Net watering need</dt>
                        <dd class="col-sm-5">@Model.Recommendation.NetNeedInches.ToString("0.00") in</dd>
                    </dl>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}